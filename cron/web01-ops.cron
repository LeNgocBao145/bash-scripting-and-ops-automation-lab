SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

# Health check every 5 minutes
*/5 * * * *   /opt/web01-ops/health-check.sh >> /var/log/web01-ops/health-check.log 2>&1

# Daily backup at 02:00
0 2 * * *     /opt/web01-ops/backup.sh >> /var/log/web01-ops/backup.log 2>&1